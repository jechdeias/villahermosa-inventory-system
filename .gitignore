# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.build/
build/

# JVM crash logs (Android build)
hs_err_pid*.log
replay_pid*.log

# Claude Code project settings
.claude/

# Environment variables
.env
.env.local
.env.production

# Supabase credentials — copy secrets.json.example → secrets.json and fill in real values
secrets.json

# NOTE: lib/core/config/supabase_config.dart used to be ignored here. It no
# longer holds credentials — it reads them from --dart-define-from-file at
# compile time — so it is committed. It must stay committed: lib/main.dart
# imports it, so ignoring it makes a fresh clone fail to compile.

# Supabase CLI local project-link cache (created by `supabase link`)
supabase/.temp/

# Android
android/.gradle/
android/local.properties

# iOS
ios/Pods/

# IDE
.vscode/
.idea/
*.iml

# Inno Setup output — the built installer and its zip are release artifacts,
# not source. The .iss script itself IS committed.
installer/**/*.exe
installer/**/*.zip

# Diagnostic capture from `flutter run ... | Tee-Object -FilePath sync.log`
sync.log
