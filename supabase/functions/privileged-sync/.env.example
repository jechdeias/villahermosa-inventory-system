# Local-development env vars for the privileged-sync Edge Function.
# Never commit a real .env here — this is a template only.
# In production, set the service key as an Edge Function secret instead:
#   supabase secrets set SERVICE_ROLE_KEY=...
# Note: it's SERVICE_ROLE_KEY, not SUPABASE_SERVICE_ROLE_KEY — Supabase
# reserves the SUPABASE_ prefix for its own platform-injected env vars and
# won't let you set a secret using it.
# SUPABASE_URL and SUPABASE_ANON_KEY are already available automatically
# to every Edge Function at runtime; they're listed here only so local
# `supabase functions serve` has them too.

SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key
