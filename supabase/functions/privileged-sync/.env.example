# Local-development env vars for the privileged-sync Edge Function.
# Never commit a real .env here — this is a template only.
# In production, set these as Edge Function secrets instead:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_URL and SUPABASE_ANON_KEY are already available automatically
# to every Edge Function at runtime; they're listed here only so local
# `supabase functions serve` has them too.

SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
